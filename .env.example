# Required file for bootstrap.sh and restart.sh; individual machine settings are optional.
# This file is sourced as shell code. Quote values containing spaces.
# Raycast and Hammerspoon read their values literally, without shell expansion or quotes.
DOTFILES_USERNAME=
DOTFILES_GIT_NAME=
DOTFILES_GIT_EMAIL=
DOTFILES_HOME_DIRECTORY=
DOTFILES_HOST_PLATFORM=

# Hammerspoon reads this directly from ~/.dotfiles/.env on reload.
# A leading ~/ is expanded; empty uses the existing default.
OBSIDIAN_DAILY_NOTE_PATH=
